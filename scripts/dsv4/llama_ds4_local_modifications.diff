diff --git a/src/llama-graph.cpp b/src/llama-graph.cpp
index 21ec872..f3d3feb 100644
--- a/src/llama-graph.cpp
+++ b/src/llama-graph.cpp
@@ -1625,6 +1625,35 @@ ggml_tensor * llm_graph_context::build_moe_ffn(
                     const float limit = hparams.swiglu_clamp_exp[il];
                     constexpr float eps = 1e-6f;
                     if (limit > eps) {
+                        if (hparams.swiglu_soft_knee > 0.0f) {
+                            // HAGI terni4 soft_lim(x, lim, knee):
+                            //   ax  = |x|;  y = ax if ax<=th else th + tail*tanh((ax-th)/tail)
+                            //   out = sgn(x) * y;   th = knee*lim, tail = lim - th
+                            const float th   = hparams.swiglu_soft_knee * limit;
+                            const float tail = limit - th;
+                            auto soft_lim = [&](ggml_tensor * x) {
+                                ggml_tensor * ax = ggml_abs(ctx0, x);
+                                ggml_tensor * kth = ggml_scale(ctx0, ggml_step(ctx0, ax), th);
+                                ggml_tensor * ktl = ggml_scale(ctx0, ggml_step(ctx0, ax), tail);
+                                ggml_tensor * sel = ggml_step(ctx0, ggml_sub(ctx0, ax, kth));
+                                ggml_tensor * t = ggml_div(ctx0, ggml_sub(ctx0, ax, kth), ktl);
+                                ggml_tensor * ysoft = ggml_add(ctx0, kth, ggml_mul(ctx0, ktl, ggml_tanh(ctx0, t)));
+                                ggml_tensor * y = ggml_add(ctx0, ax, ggml_mul(ctx0, sel, ggml_sub(ctx0, ysoft, ax)));
+                                return ggml_mul(ctx0, ggml_sgn(ctx0, x), y);
+                            };
+                            cur = soft_lim(cur);
+                            cb(cur, "ffn_moe_gate_softlim", il);
+
+                            ggml_tensor * gate_act = ggml_silu(ctx0, cur);
+                            cb(gate_act, "ffn_moe_silu", il);
+
+                            up = soft_lim(up);
+                            cb(up, "ffn_moe_up_softlim", il);
+
+                            cur = ggml_mul(ctx0, gate_act, up);
+                            cb(cur, "ffn_moe_swiglu_limited", il);
+                            break;
+                        }
                         cur = ggml_clamp(ctx0, cur, -INFINITY, limit);
                         cb(cur, "ffn_moe_gate_clamped", il);
 
